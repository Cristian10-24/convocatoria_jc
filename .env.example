# Copia este archivo como .env.local y completa los valores. En Vercel se configuran en
# Project → Settings → Environment Variables. Nunca subas valores reales al repositorio.

# --- MongoDB Atlas -------------------------------------------------------------
# Cadena de conexión SRV del cluster (usuario con permisos solo sobre la base de abajo).
MONGODB_URI=mongodb+srv://usuario:clave@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Base de datos de la app. Usa otra (p. ej. convocatoria_jc_pruebas) para previews y pruebas de carga.
MONGODB_DB=convocatoria_jc
# Conexiones máximas por instancia de función (opcional, por defecto 10).
MONGODB_MAX_POOL=10

# --- Aplicación ----------------------------------------------------------------
# URL pública (sin barra final). Se usa para metadatos (og:image) y para validar el origen.
APP_URL=https://convocatoria.tocaunavida.org
# Identificador de la convocatoria activa (se guarda en cada inscripción).
CONVOCATORIA_ID=jc-2027
# Estado y botones por país, en JSON (ver README). Vacío = valores por defecto ("muy pronto").
CONVOCATORIA_CONFIG=

# --- Seguridad -----------------------------------------------------------------
# Secreto para firmar la cookie del panel (mínimo 32 caracteres aleatorios).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Sal para guardar la IP solo como hash (mínimo 16 caracteres aleatorios).
IP_HASH_SALT=
# Envíos de inscripción permitidos por IP cada 15 minutos (los colegios comparten IP).
RATE_LIMIT_INSCRIPCION=60
# Intentos fallidos de login permitidos por IP cada 15 minutos.
RATE_LIMIT_LOGIN=10

# --- Cloudflare Turnstile (obligatorio en producción) --------------------------
# Claves del widget en dash.cloudflare.com → Turnstile. Para pruebas locales se pueden usar las de prueba
# de Cloudflare: sitio 1x00000000000000000000AA y secreto 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Enlaces ---------------------------------------------------------------------
NEXT_PUBLIC_PRIVACY_URL=https://tocaunavida.org
